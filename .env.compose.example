# Host-exposed ports
EXEC_FRONTEND_HOST_PORT=5173
EXEC_FRONTEND_PORT=5173
EXEC_BACKEND_HOST_PORT=3000
EXEC_BACKEND_PORT=3000

# Postgres
POSTGRES_DB=exec_dashboard
POSTGRES_USER=exec_dashboard
POSTGRES_PASSWORD=

# Internal service ports
KARTANA_INTERNAL_PORT=8080
MEMBERSHIP_PORTAL_INTERNAL_PORT=8080

# Service images
KARTANA_IMAGE=acmucsd/kartana:latest
MEMBERSHIP_PORTAL_IMAGE=acmucsd/membership-portal-api:latest

# Service environment files
KARTANA_ENV_FILE=../kartana/.env
MEMBERSHIP_PORTAL_ENV_FILE=../membership-portal/.env

# Local build mode overrides (used with docker-compose.build.yml)
KARTANA_BUILD_CONTEXT=../kartana
KARTANA_DOCKERFILE=Dockerfile
KARTANA_LOCAL_IMAGE=kartana:dev

MEMBERSHIP_PORTAL_BUILD_CONTEXT=../membership-portal
MEMBERSHIP_PORTAL_DOCKERFILE=Dockerfile
MEMBERSHIP_PORTAL_LOCAL_IMAGE=membership-portal:dev
